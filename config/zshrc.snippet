# --- r-workstation: Oh My Zsh plugin configuration ---
# Add these to your plugins=(...) list in ~/.zshrc:
#
#   plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
#
# The plugins must be cloned into $ZSH_CUSTOM/plugins/ first.
# The setup script (layers/01-terminal.sh) handles both steps automatically.
# --- end r-workstation ---
